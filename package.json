{
  "name": "social-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Write once, audit against each platform's best practices, schedule everywhere.",
  "type": "module",
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create social-studio",
    "db:migrate": "wrangler d1 execute social-studio --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute social-studio --local --file=./schema.sql",
    "bucket:create": "wrangler r2 bucket create social-studio-media",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
